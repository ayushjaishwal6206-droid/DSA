class Solution {
public:
    int maximumCount(vector<int>& nums) {
        int n = nums.size(), low = 0, high = n - 1;

        while (low <= high) {
            int mid = (low + high) / 2;
            if (nums[mid] < 0) low = mid + 1;
            else high = mid - 1;
        }
        int neg = low;

        low = 0, high = n - 1;

        while (low <= high) {
            int mid = (low + high) / 2;
            if (nums[mid] <= 0) low = mid + 1;
            else high = mid - 1;
        }
        int pos = n - low;

        return max(pos, neg);
    }
};
