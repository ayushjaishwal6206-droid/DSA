class Solution {
public:
    void rotate(vector<vector<int>>& arr) {
        int n = arr.size();
        
       // Transpose of the matrix
        for(int i = 0; i < n; i++){
            for(int j = i+1; j < n; j++){
                int temp = arr[i][j];
                arr[i][j] = arr[j][i];
                arr[j][i] = temp;
            }
        }
        // Reverse Every Row
        for(int i = 0; i < n; i++){
            reverse(arr[i].begin(), arr[i].end());
            // Rather Writing this 
            // int start = 0;
