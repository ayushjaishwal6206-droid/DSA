class Solution {
public:
    vector<int> findIntersectionValues(vector<int>& num1, vector<int>& num2) {
        int n = num1.size();
        int m = num2.size();
        int count1 = 0;
        int count2 = 0;
        for(int i = 0; i < n; i++){
            for(int j= 0; j < m; j++){
                if(num1[i] == num2[j]){
                    count1++;
                    break;
                }
            }
        }
        for(int i = 0; i < m; i++){
            for(int j = 0; j < n; j++){
                if(num2[i] == num1[j]){
                    count2++;
                    break;
                }
            }
        }
        return{count1, count2};
    }
};
