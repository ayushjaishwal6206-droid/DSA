//Moving All Zero to end

#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main(){
    vector <int> arr = {9,-2,0,0,-4,6,0,7,0};
    int n = arr.size();
    for(int i = 0; i < n-1; i++){
        for(int j = 0; j < n-i-1; j++){
            if(arr[j] == 0 && arr[j+1] != 0){
                swap(arr[j],arr[j+1]);  
            }
        }
    }
    for(int ele : arr){
        cout<<ele<<" ";
    }
}
