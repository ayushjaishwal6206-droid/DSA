class Solution {
public:
    int peakIndexInMountainArray(vector<int>& arr) {
        int n = arr.size();
        int low = 1;
        int high = n-2;
        while(low <= high){
            int peak = (low + high) / 2;
            if(arr[peak - 1] < arr[peak] && arr[peak] <arr[peak + 1]){
                low = peak + 1;
            }
            else if(arr[peak - 1] > arr[peak] && arr[peak] > arr[peak + 1]){
                high = peak - 1;
            }
            else{
                return peak;
            } 
        }
        return 0;
    }
};
