// Online C++ compiler to run C++ program online
#include <iostream>
using namespace std;

int main(){
    int a[] = { 10,20,40,70,90,100};
    int b[] = {30,50,60,80};
    // Size of the array
    int m = sizeof(a)/4;
    int n = sizeof(b)/4;
    
    int c[m + n];
    int i  =0;
    int j = 0;
    int k = 0;
    while(i < m && j < n){
        if(a[i] < b[j]){
            c[k] = a[i];
            i++;
            k++;
        }
        else{  // b[j] < a[i]
            c[k] = b[j];
            j++;
            k++;
        }
    }
    while(j <n){
        c[k] = b[j];
        j++;
        k++;
    }
    while(i < m){
        c[k] = a[i];
        i++;
        k++;
    }
    for(int i = 0; i < m + n; i++){
        cout<<c[i]<<" ";
    }
}
