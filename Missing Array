class Solution {
public:
    int missingNumber(vector<int>& v) {
        int n = v.size();
        
        int excepted = n * (n + 1) / 2;
        int actual = 0;
        for(int i = 0; i < n; i++){
            actual = actual + v[i];
        }
        int missing = excepted - actual;
        return missing;
    } 
};
