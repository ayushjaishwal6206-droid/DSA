// Online C++ compiler to run C++ program online
#include<iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main(){
    vector <int> v = {10,20,40,70,90};
    sort(v.begin(),v.end());
    vector <int> q = {30,50,60,80};
    sort(v.begin(),v.end());
    vector <int> ans;
    for(int i= 0; i < v.size(); i++){
        ans.push_back(v[i]);
    }
    for(int i = 0 ; i < q.size(); i++){
        ans.push_back(q[i]);
    }
    sort(ans.begin(),ans.end());
    for(int i = 0; i < ans.size(); i++){
        cout<<ans[i]<<" ";
    }
}
